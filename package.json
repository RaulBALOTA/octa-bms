{
  "name": "octa-bms",
  "version": "0.1.0",
  "private": true,
  "description": "OCTA Business Management System \u2014 Enterprise ERP for German engineering & EPCM consulting companies",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:api": "pnpm --filter @octa-bms/api dev",
    "dev:web": "pnpm --filter @octa-bms/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @octa-bms/api prisma:generate",
    "db:push": "pnpm --filter @octa-bms/api prisma:push",
    "db:migrate": "pnpm --filter @octa-bms/api prisma:migrate",
    "db:seed": "pnpm --filter @octa-bms/api prisma:seed"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "proxy-addr@<2.0.8": "2.0.8"
    }
  }
}
