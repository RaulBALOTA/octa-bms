# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql://octa:octa@localhost:5432/octa_bms

# --- Infrastructure ----------------------------------------------------------
REDIS_URL=redis://localhost:6379
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=dev-master-key
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=octa-bms
S3_ACCESS_KEY=octa
S3_SECRET_KEY=octa-secret

# --- Auth --------------------------------------------------------------------
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
# First administrator on a fresh database; normal seed preserves existing admins.
# Choose your own email and a password of at least 12 characters before seeding.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Azure Entra SSO — app registration with redirect URI
#   {API_URL}/api/v1/auth/oidc/callback  (leave empty for local auth only)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# --- Microsoft integration ----------------------------------------------------
# Graph mail (app-only): grant the Entra app "Mail.Send" application permission
# and set the sending mailbox
GRAPH_SENDER_UPN=
# Teams channel: Incoming Webhook connector URL — announcements are mirrored there
TEAMS_WEBHOOK_URL=

# --- Mail --------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=bms@octa.example

# --- AI ----------------------------------------------------------------------
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# --- App ---------------------------------------------------------------------
APP_URL=http://localhost:5180
API_URL=http://localhost:3000
PORT=3000
LOG_LEVEL=info
# Company Calendar: enable only after applying prisma/sql/add_business_calendar.sql.
COMPANY_CALENDAR_ENABLED=false

# --- Working time & PMO connector --------------------------------------------
# Calendar days and ArbZG checks are evaluated in this time zone.
TIME_ZONE=Europe/Berlin
# PMO app (services/api) base URL and a PMO service account used to read
# /api/workforce/timesheets, /api/users and /api/projects. Leave empty to disable.
PMO_API_URL=
PMO_SERVICE_EMAIL=
PMO_SERVICE_PASSWORD=
# Rolling window (days) mirrored on each sync; PMO returns at most 500 rows.
PMO_SYNC_DAYS=35
# Hourly background sync for every active company.
PMO_SYNC_ENABLED=false
