# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql://octa:octa@localhost:5432/octa_bms

# --- Infrastructure ----------------------------------------------------------
REDIS_URL=redis://localhost:6379
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=dev-master-key
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=octa-bms
S3_ACCESS_KEY=octa
S3_SECRET_KEY=octa-secret

# --- Auth --------------------------------------------------------------------
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
# First administrator on a fresh database; normal seed preserves existing admins.
# Choose your own email and a password of at least 12 characters before seeding.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Azure Entra SSO — app registration with redirect URI
#   {API_URL}/api/v1/auth/oidc/callback  (leave empty for local auth only)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# --- Microsoft integration ----------------------------------------------------
# Graph mail (app-only): grant the Entra app "Mail.Send" application permission
# and set the sending mailbox
GRAPH_SENDER_UPN=
# Teams channel: Incoming Webhook connector URL — announcements are mirrored there
TEAMS_WEBHOOK_URL=

# --- Bank connections (read-only) ---------------------------------------------
# Enable only after applying prisma/sql/add_bank_connections.sql and
# prisma/sql/grant_banking_permissions.sql on an existing database. See docs/banking.md.
BANKING_ENABLED=false
# 32 random bytes, base64 — encrypts stored bank credentials: openssl rand -base64 32
# Keep it stable and backed up: losing it means every bank must be reconnected.
BANKING_ENCRYPTION_KEY=
# Days of history fetched on the first sync of a new connection
BANKING_SYNC_LOOKBACK_DAYS=90
# Qonto Business API (API key is entered per connection in the UI)
QONTO_API_BASE=https://thirdparty.qonto.com
# Qonto sandbox only: X-Qonto-Staging-Token (and the sandbox API base URL)
QONTO_STAGING_TOKEN=
# Other banks via the PSD2 aggregator Enable Banking (https://enablebanking.com).
# Register an application, set its redirect URL to {APP_URL}/finance/banking/callback,
# then set the application id and its private key (path to the .pem or the PEM itself).
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY=
ENABLE_BANKING_API_BASE=https://api.enablebanking.com
BANKING_CONSENT_DAYS=180

# --- Mail --------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=bms@octa.example

# --- AI ----------------------------------------------------------------------
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# --- App ---------------------------------------------------------------------
APP_URL=http://localhost:5180
API_URL=http://localhost:3000
PORT=3000
LOG_LEVEL=info
# Company Calendar: enable only after applying prisma/sql/add_business_calendar.sql.
COMPANY_CALENDAR_ENABLED=false
