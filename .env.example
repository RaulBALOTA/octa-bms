# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql://octa:octa@localhost:5432/octa_bms

# --- Infrastructure ----------------------------------------------------------
REDIS_URL=redis://localhost:6379
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=dev-master-key
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=octa-bms
S3_ACCESS_KEY=octa
S3_SECRET_KEY=octa-secret

# --- Auth ---------------------------------------------------------------------
# Names only — operators provision values from a secret manager. Never commit secrets.
# Public origin of the SPA (same-origin reverse proxy serves /api). Must be https in production.
APP_PUBLIC_ORIGIN=http://localhost:5180
# Extra allowed origins for CSRF/CORS (comma-separated, no wildcards). Usually empty.
CORS_ALLOWED_ORIGINS=
# Reverse-proxy hops to trust for client IPs: hop count ("1"), subnet list, or "false".
# Required in production. Default (unset, non-production): loopback only.
TRUST_PROXY=
# Defaults: "__Host-bms_session" on https origins, "bms_session" on http (local dev).
SESSION_COOKIE_NAME=
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12
# Microsoft Authenticator profile (fixed): SHA-1, 6 digits, 30 seconds.
MFA_TOTP_ISSUER=OCTA BMS
MFA_TOTP_PERIOD_SECONDS=30
MFA_TOTP_DIGITS=6
# disabled | optional | enrollment_required | enforced (admin policy in the UI overrides this)
MFA_REQUIRED_MODE=optional
MFA_PREAUTH_TTL_SECONDS=300
MFA_STEP_UP_MAX_AGE_MINUTES=10
# 32-byte key, base64 (generate: pnpm --filter @octa-bms/api auth:admin generate-key).
# Required in production; injected at runtime from the secret manager, NEVER stored in git or the DB.
AUTH_ENCRYPTION_KEY_ID=key-v1
AUTH_ENCRYPTION_KEY=
# Retired keys still needed to decrypt existing seeds: "key-v0:<base64>,…" (rotation)
AUTH_ENCRYPTION_PREVIOUS_KEYS=
# Argon2id cost (defaults m=65536 KiB, t=3, p=4; benchmarked at startup)
ARGON2_MEMORY_KIB=
ARGON2_TIME_COST=
ARGON2_PARALLELISM=
PASSWORD_MIN_LENGTH=12
# true = Have I Been Pwned k-anonymity range check (only a 5-char SHA-1 prefix leaves the server)
PASSWORD_HIBP_CHECK=false
PASSWORD_RESET_TTL_MINUTES=30
INVITATION_TTL_HOURS=72
SECURITY_EVENT_RETENTION_DAYS=400
# First administrator on a fresh database (CLI seed only; there is no bootstrap route).
# Choose your own email and a password of at least 12 characters before seeding.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Azure Entra SSO — app registration with redirect URI
#   {API_URL}/api/v1/auth/oidc/callback  (leave empty for local auth only)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Create unknown Entra users on first SSO login (default false: invite them first)
ENTRA_AUTO_PROVISION=false

# --- Microsoft integration ----------------------------------------------------
# Graph mail (app-only): grant the Entra app "Mail.Send" application permission
# and set the sending mailbox
GRAPH_SENDER_UPN=
# Teams channel: Incoming Webhook connector URL — announcements are mirrored there
TEAMS_WEBHOOK_URL=

# --- Mail --------------------------------------------------------------------
# Security email (reset, invitations, notifications). Mailpit in dev; provider relay in prod.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=bms@octa.example

# --- AI ----------------------------------------------------------------------
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# --- App ---------------------------------------------------------------------
APP_URL=http://localhost:5180
API_URL=http://localhost:3000
PORT=3000
LOG_LEVEL=info
# Company Calendar: enable only after applying prisma/sql/add_business_calendar.sql.
COMPANY_CALENDAR_ENABLED=false
