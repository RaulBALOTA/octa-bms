# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql://octa:octa@localhost:5432/octa_bms

# --- Infrastructure ----------------------------------------------------------
REDIS_URL=redis://localhost:6379
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=dev-master-key
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=octa-bms
S3_ACCESS_KEY=octa
S3_SECRET_KEY=octa-secret

# --- Auth --------------------------------------------------------------------
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
# Azure Entra SSO (leave empty for local auth only)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# --- Mail --------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=bms@octa.example

# --- AI ----------------------------------------------------------------------
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# --- App ---------------------------------------------------------------------
APP_URL=http://localhost:5180
API_URL=http://localhost:3000
PORT=3000
LOG_LEVEL=info
