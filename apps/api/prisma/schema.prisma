enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  NOTICE_PERIOD
  TERMINATED
  RETIRED
}

model Employee {
  id             String           @id @default(cuid())
  companyId      String
  officeId       String?
  departmentId   String?
  positionId     String?
  managerId      String?
  userId         String?          @unique
  employeeNumber String
  salutation     String?
  title          String? // Dr., Dipl.-Ing., M.Sc.
  firstName      String
  lastName       String
  birthDate      DateTime?
  nationality    String?
  privateEmail   String?
  workEmail      String?
  phone          String?
  mobile         String?
  street         String?
  postalCode     String?
  city           String?
  countryCode    String?
  status         EmploymentStatus @default(ACTIVE)
  hireDate       DateTime?
  exitDate       DateTime?
  weeklyHours    Decimal?         @db.Decimal(4, 1)
  vacationDays   Decimal?         @db.Decimal(4, 1)
  discipline     String? // engineering discipline
  photoUrl       String?
  emergencyContact String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  company            Company             @relation(fields: [companyId], references: [id])
  office             Office?             @relation(fields: [officeId], references: [id])
  department         Department?         @relation(fields: [departmentId], references: [id])
  position           Position?           @relation(fields: [positionId], references: [id])
  manager            Employee?           @relation("ManagerHierarchy", fields: [managerId], references: [id])
  directReports      Employee[]          @relation("ManagerHierarchy")
  user               User?               @relation(fields: [userId], references: [id])
  managedDepartments Department[]        @relation("DepartmentManager")
  ledBusinessUnits   BusinessUnit[]
  employmentContracts EmploymentContract[]
  skills             EmployeeSkill[]
  certificates       EmployeeCertificate[]
  trainings          TrainingParticipation[]
  leaveRequests      LeaveRequest[]
  leaveBalances      LeaveBalance[]
  businessTrips      BusinessTrip[]
  performanceReviews PerformanceReview[] @relation("ReviewedEmployee")
  givenReviews       PerformanceReview[] @relation("Reviewer")
  assetAssignments   AssetAssignment[]
  crmActivities      CrmActivity[]
  managedPartners    BusinessPartner[]
  ownedOpportunities Opportunity[]
  managedProposals   Proposal[]
  ownedContracts     Contract[]
  cvProfile          CvProfile?
  engineResources    EngineResource[]
  ownedEngineServices EngineService[]
  engineAssignments  EngineAssignment[]

  @@unique([companyId, employeeNumber])
  @@index([companyId, status])
  @@index([lastName, firstName])
  @@map("employees")
}

model Position {
  id           String  @id @default(cuid())
  departmentId String?
  code         String  @unique
  name         String
  nameDe       String?
  level        String? // JUNIOR | PROFESSIONAL | SENIOR | LEAD | PRINCIPAL | DIRECTOR
  isActive     Boolean @default(true)

  department Department? @relation(fields: [departmentId], references: [id])
  employees  Employee[]
  plans      PositionPlan[]

  @@map("positions")
}

enum PositionStatus {
  OPEN
  BUDGETED
  FILLED
}

// Staffing plans are company-specific, including for shared position definitions.
// FILLED is derived from active employee assignments; plans retain their vacancy state.
model PositionPlan {
  id         String         @id @default(cuid())
  companyId  String
  positionId String
  status     PositionStatus @default(OPEN)
  updatedAt  DateTime       @updatedAt

  company  Company  @relation(fields: [companyId], references: [id])
  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@unique([companyId, positionId])
  @@map("position_plans")
}

model OrgChartVersion {
  id          String   @id @default(cuid())
  companyId   String
  version     Int
  title       String
  note        String?
  snapshot    Json
  createdById String
  createdAt   DateTime @default(now())

  company   Company @relation(fields: [companyId], references: [id])
  createdBy User    @relation(fields: [createdById], references: [id])

  @@unique([companyId, version])
  @@map("org_chart_versions")
}

model StaffingBudgetScenario {
  id             String   @id @default(cuid())
  companyId      String
  title          String
  year           Int
  currency       String
  fiscalYearStart Int
  version        Int      @default(1)
  plan           Json
  result         Json
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company   Company @relation(fields: [companyId], references: [id])
  createdBy User @relation(fields: [createdById], references: [id])
  revisions StaffingBudgetRevision[]

  @@index([companyId, year])
  @@map("staffing_budget_scenarios")
}

model StaffingBudgetRevision {
  id           String   @id @default(cuid())
  scenarioId   String
  version      Int
  plan         Json
  result       Json
  note         String?
  createdById  String
  createdAt    DateTime @default(now())

  scenario  StaffingBudgetScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id])

  @@unique([scenarioId, version])
  @@map("staffing_budget_revisions")
}

model EmploymentContract {
  id           String    @id @default(cuid())
  employeeId   String
  contractType String // PERMANENT | FIXED_TERM | PART_TIME | WORKING_STUDENT | FREELANCE | INTERNSHIP
  startDate    DateTime
  endDate      DateTime?
  weeklyHours  Decimal   @db.Decimal(4, 1)
  annualSalary Decimal?  @db.Decimal(18, 2)
  vacationDays Decimal   @db.Decimal(4, 1)
  probationEndDate DateTime?
  noticePeriodWeeks Int?
  fileId       String? // Document

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("employment_contracts")
}

model Skill {
  id       String @id @default(cuid())
  category String // DISCIPLINE | SOFTWARE | LANGUAGE | METHOD | SOFT_SKILL
  name     String
  nameDe   String?
  parentId String? // hierarchy (Business Engine skills taxonomy)

  parent               Skill?                     @relation("SkillHierarchy", fields: [parentId], references: [id])
  children             Skill[]                    @relation("SkillHierarchy")
  employeeSkills       EmployeeSkill[]
  engineRequirements   EngineServiceRequirement[]
  engineResourceSkills EngineResourceSkill[]
