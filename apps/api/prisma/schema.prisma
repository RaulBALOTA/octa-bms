  partner BusinessPartner? @relation(fields: [partnerId], references: [id])

  @@map("legal_cases")
}

model ComplianceItem {
  id           String    @id @default(cuid())
  category     String // GDPR | ISO_9001 | ISO_14001 | ISO_45001 | LICENSE | REGISTER | TAX | OTHER
  title        String
  description  String?
  responsibleId String?
  dueDate      DateTime?
  recurrence   String? // YEARLY | QUARTERLY | MONTHLY
