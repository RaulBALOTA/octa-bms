  startDate  DateTime
  endDate    DateTime
  days       Decimal     @db.Decimal(4, 1)
  note       String?
  approvedById String?
  decidedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, startDate])
  @@map("leave_requests")
}

model LeaveBalance {
  id           String  @id @default(cuid())
  employeeId   String
  year         Int
  entitlement  Decimal @db.Decimal(4, 1)
  carryOver    Decimal @default(0) @db.Decimal(4, 1)
  taken        Decimal @default(0) @db.Decimal(4, 1)

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, year])
  @@map("leave_balances")
}

model BusinessTrip {
