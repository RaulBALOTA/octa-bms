  employeeId  String
  destination String
  purpose     String
  startDate   DateTime
  endDate     DateTime
  status      String    @default("REQUESTED") // REQUESTED | APPROVED | REJECTED | COMPLETED | SETTLED
  estimatedCost Decimal? @db.Decimal(18, 2)
  actualCost  Decimal?  @db.Decimal(18, 2)
  approvedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

