  dataSubjects   String
  recipients     String?
  retentionPeriod String?
  technicalMeasures String?
  responsibleId  String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("data_processing_activities")
}

model WhistleblowerReport {
  id          String   @id @default(cuid())
  referenceCode String @unique // anonymous access code
  category    String
  description String
  status      String   @default("SUBMITTED") // SUBMITTED | UNDER_REVIEW | INVESTIGATION | CLOSED
  isAnonymous Boolean  @default(true)
  submittedAt DateTime @default(now())
  closedAt    DateTime?
  resolution  String?

  @@map("whistleblower_reports")
}

model ProfessionalLicense {
  id         String    @id @default(cuid())
  holderType String // COMPANY | EMPLOYEE
  holderId   String
  name       String // e.g. "Beratender Ingenieur (Ingenieurkammer Bayern)"
  authority  String?
  licenseNumber String?
  issuedDate DateTime?
  expiryDate DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([expiryDate])
  @@map("professional_licenses")
}

// =====================================================================
// 10. CORPORATE PROCUREMENT
// =====================================================================

enum PurchaseStatus {
  DRAFT
  SUBMITTED
  IN_APPROVAL
  APPROVED
  REJECTED
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  INVOICED
  CLOSED
  CANCELLED
}

model PurchaseRequest {
  id            String         @id @default(cuid())
  companyId     String
  requestNumber String
  requesterId   String // Employee
  category      String // IT | SOFTWARE | OFFICE | VEHICLE | FURNITURE | SERVICE | OTHER
  status        PurchaseStatus @default(DRAFT)
  neededBy      DateTime?
  justification String?
  totalEstimate Decimal?       @db.Decimal(18, 2)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?

  company Company               @relation(fields: [companyId], references: [id])
  items   PurchaseRequestItem[]
  orders  PurchaseOrder[]

  @@unique([companyId, requestNumber])
  @@map("purchase_requests")
}

model PurchaseRequestItem {
  id          String  @id @default(cuid())
  requestId   String
  description String
  quantity    Decimal @db.Decimal(12, 3)
  unit        String  @default("pcs")
  estimatedPrice Decimal? @db.Decimal(18, 2)

  request PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("purchase_request_items")
}

model PurchaseOrder {
  id          String         @id @default(cuid())
  companyId   String
  requestId   String?
  supplierId  String
  orderNumber String
  status      PurchaseStatus @default(ORDERED)
  orderDate   DateTime       @default(now())
  expectedDelivery DateTime?
  currencyCode String        @default("EUR")
  netTotal    Decimal        @db.Decimal(18, 2)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?

  company  Company             @relation(fields: [companyId], references: [id])
  request  PurchaseRequest?    @relation(fields: [requestId], references: [id])
  supplier BusinessPartner     @relation(fields: [supplierId], references: [id])
  items    PurchaseOrderItem[]
  receipts GoodsReceipt[]

  @@unique([companyId, orderNumber])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id          String  @id @default(cuid())
  orderId     String
  description String
  quantity    Decimal @db.Decimal(12, 3)
  unit        String  @default("pcs")
  unitPrice   Decimal @db.Decimal(18, 4)
  receivedQty Decimal @default(0) @db.Decimal(12, 3)

  order PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("purchase_order_items")
}

model GoodsReceipt {
  id         String   @id @default(cuid())
  orderId    String
  receivedAt DateTime @default(now())
  receivedById String?
  note       String?

  order PurchaseOrder @relation(fields: [orderId], references: [id])

  @@map("goods_receipts")
}

model SupplierEvaluation {
  id         String   @id @default(cuid())
  supplierId String
  period     String // "2026-Q2"
  quality    Int // 1-5
  delivery   Int
  price      Int
  communication Int
  overallScore Decimal @db.Decimal(3, 2)
  comments   String?
  evaluatedById String?

  createdAt DateTime @default(now())

  supplier BusinessPartner @relation(fields: [supplierId], references: [id])

  @@unique([supplierId, period])
  @@map("supplier_evaluations")
}

// =====================================================================
// 11. ASSET MANAGEMENT
// =====================================================================

enum AssetStatus {
  IN_STOCK
  ASSIGNED
  IN_REPAIR
  RETIRED
  LOST
  SOLD
}

model Asset {
  id             String      @id @default(cuid())
  companyId      String
  categoryId     String
  assetNumber    String // also encoded in QR code
  name           String
  serialNumber   String?
  manufacturer   String?
  model          String?
  status         AssetStatus @default(IN_STOCK)
  purchaseDate   DateTime?
  purchasePrice  Decimal?    @db.Decimal(18, 2)
  warrantyUntil  DateTime?
  leaseEndDate   DateTime?
  licensePlate   String? // vehicles
  nextServiceDate DateTime? // maintenance / calibration / TÜV
  location       String?
  notes          String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?

  company     Company             @relation(fields: [companyId], references: [id])
  category    AssetCategory       @relation(fields: [categoryId], references: [id])
  assignments AssetAssignment[]
  maintenance MaintenanceRecord[]

  @@unique([companyId, assetNumber])
  @@index([companyId, status])
  @@index([nextServiceDate])
  @@map("assets")
}

model AssetAssignment {
  id         String    @id @default(cuid())
  assetId    String
  employeeId String
  assignedAt DateTime  @default(now())
  returnedAt DateTime?
  note       String?
  handoverSignedAt DateTime?

  asset    Asset    @relation(fields: [assetId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([assetId])
  @@map("asset_assignments")
}

model MaintenanceRecord {
  id          String   @id @default(cuid())
  assetId     String
  type        String // MAINTENANCE | REPAIR | CALIBRATION | INSPECTION | TUV
  performedAt DateTime
  performedBy String?
  cost        Decimal? @db.Decimal(18, 2)
  result      String?
  nextDueDate DateTime?

  asset Asset @relation(fields: [assetId], references: [id])

  @@map("maintenance_records")
}

model SoftwareLicense {
  id          String    @id @default(cuid())
  name        String // "AutoCAD 2026", "MS 365 E3"
  vendor      String?
  licenseType String // PERPETUAL | SUBSCRIPTION | FLOATING | NAMED_USER
  seats       Int       @default(1)
  usedSeats   Int       @default(0)
  costPerYear Decimal?  @db.Decimal(18, 2)
  renewalDate DateTime?
  licenseKey  String?
  assignedUserIds String[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([renewalDate])
  @@map("software_licenses")
}

// =====================================================================
// 12. KNOWLEDGE MANAGEMENT
// =====================================================================

model KnowledgeCategory {
  id       String  @id @default(cuid())
  parentId String?
  name     String
  nameDe   String?
  sortOrder Int    @default(0)

  parent   KnowledgeCategory?  @relation("KnowledgeCategoryTree", fields: [parentId], references: [id])
  children KnowledgeCategory[] @relation("KnowledgeCategoryTree")
  articles KnowledgeArticle[]

  @@map("knowledge_categories")
}

model KnowledgeArticle {
  id         String    @id @default(cuid())
  categoryId String?
  type       String    @default("ARTICLE") // ARTICLE | STANDARD | PROCEDURE | TEMPLATE | LESSON_LEARNED | FAQ
  title      String
  content    String // Markdown
  language   String    @default("de")
  status     String    @default("DRAFT") // DRAFT | IN_REVIEW | PUBLISHED | ARCHIVED
  publishedAt DateTime?
  authorId   String?
  reviewerId String?
  viewCount  Int       @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?

  category KnowledgeCategory? @relation(fields: [categoryId], references: [id])
  versions ArticleVersion[]

  @@index([status])
  @@map("knowledge_articles")
}

model ArticleVersion {
  id        String   @id @default(cuid())
  articleId String
  version   Int
  content   String
  createdAt DateTime @default(now())
  createdById String?

  article KnowledgeArticle @relation(fields: [articleId], references: [id])

  @@unique([articleId, version])
  @@map("article_versions")
}

// =====================================================================
// 13. DOCUMENT MANAGEMENT
// =====================================================================

model Folder {
  id        String  @id @default(cuid())
  parentId  String?
  name      String
  path      String // materialized path "/Contracts/2026"
  companyId String?
  module    String? // owning module, null = general DMS

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  parent    Folder?    @relation("FolderTree", fields: [parentId], references: [id])
  children  Folder[]   @relation("FolderTree")
  documents Document[]

  @@index([path])
  @@map("folders")
}

model Document {
  id             String    @id @default(cuid())
  folderId       String?
  documentTypeId String?
  name           String
  title          String? // optional display title, independent of the original filename
  description    String?
  currentVersion Int       @default(1)
  checkedOutById String? // null = not checked out
  checkedOutAt   DateTime?
  retentionUntil DateTime?
  ocrText        String? // extracted full text for search
  entityType     String? // linked business entity ("contract", "invoice", ...)
  entityId       String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?

  folder       Folder?           @relation(fields: [folderId], references: [id])
  documentType DocumentTypeRef?  @relation(fields: [documentTypeId], references: [id])
  versions     DocumentVersion[]

  @@index([entityType, entityId])
  @@index([folderId])
  @@map("documents")
}

model DocumentVersion {
  id         String   @id @default(cuid())
  documentId String
  version    Int
  fileName   String
  mimeType   String
  sizeBytes  Int
  storageKey String // S3/MinIO object key
  checksum   String? // SHA-256
  note       String?
  createdAt  DateTime @default(now())
  createdById String?

  document Document @relation(fields: [documentId], references: [id])

  @@unique([documentId, version])
  @@map("document_versions")
}

// =====================================================================
// 14. WORKFLOW ENGINE
// =====================================================================

model WorkflowDefinition {
  id          String  @id @default(cuid())
  code        String  @unique // "invoice-approval", "leave-approval"
  name        String
  description String?
  module      String
  entityType  String // entity the workflow attaches to
  definition  Json // steps, conditions, escalations (designer output)
  version     Int     @default(1)
  isActive    Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  instances WorkflowInstance[]

  @@map("workflow_definitions")
}

enum WorkflowStatus {
  RUNNING
  COMPLETED
  REJECTED
  CANCELLED
  FAILED
}

model WorkflowInstance {
  id           String         @id @default(cuid())
  definitionId String
  entityType   String
  entityId     String
  status       WorkflowStatus @default(RUNNING)
  currentStep  String?
  context      Json? // runtime variables
  startedById  String?
  startedAt    DateTime       @default(now())
  completedAt  DateTime?

  definition WorkflowDefinition @relation(fields: [definitionId], references: [id])
  tasks      ApprovalTask[]

  @@index([entityType, entityId])
  @@index([status])
  @@map("workflow_instances")
}

enum ApprovalTaskStatus {
  PENDING
  APPROVED
  REJECTED
  DELEGATED
  ESCALATED
  CANCELLED
}

model ApprovalTask {
  id           String             @id @default(cuid())
  instanceId   String
  stepCode     String
  title        String
  assigneeId   String // User
  status       ApprovalTaskStatus @default(PENDING)
  dueAt        DateTime?
  escalateToId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  instance WorkflowInstance @relation(fields: [instanceId], references: [id])
  actions  ApprovalAction[]

  @@index([assigneeId, status])
  @@map("approval_tasks")
}

model ApprovalAction {
  id       String   @id @default(cuid())
  taskId   String
  userId   String
  action   String // APPROVE | REJECT | DELEGATE | COMMENT
  comment  String?
  actedAt  DateTime @default(now())

  task ApprovalTask @relation(fields: [taskId], references: [id])
  user User         @relation(fields: [userId], references: [id])

  @@map("approval_actions")
}

// =====================================================================
// 15. CORPORATE MANAGEMENT
