enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  NOTICE_PERIOD
  TERMINATED
  RETIRED
}

model Employee {
  id             String           @id @default(cuid())
  companyId      String
  officeId       String?
  departmentId   String?
  positionId     String?
  managerId      String?
  userId         String?          @unique
  employeeNumber String
  salutation     String?
  title          String? // Dr., Dipl.-Ing., M.Sc.
  firstName      String
  lastName       String
  birthDate      DateTime?
  nationality    String?
  privateEmail   String?
  workEmail      String?
  phone          String?
  mobile         String?
  street         String?
  postalCode     String?
  city           String?
  countryCode    String?
  status         EmploymentStatus @default(ACTIVE)
  hireDate       DateTime?
  exitDate       DateTime?
  weeklyHours    Decimal?         @db.Decimal(4, 1)
  vacationDays   Decimal?         @db.Decimal(4, 1)
  discipline     String? // engineering discipline
  photoUrl       String?
  emergencyContact String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  company            Company             @relation(fields: [companyId], references: [id])
  office             Office?             @relation(fields: [officeId], references: [id])
  department         Department?         @relation(fields: [departmentId], references: [id])
  position           Position?           @relation(fields: [positionId], references: [id])
  manager            Employee?           @relation("ManagerHierarchy", fields: [managerId], references: [id])
  directReports      Employee[]          @relation("ManagerHierarchy")
  user               User?               @relation(fields: [userId], references: [id])
  managedDepartments Department[]        @relation("DepartmentManager")
  ledBusinessUnits   BusinessUnit[]
  employmentContracts EmploymentContract[]
  skills             EmployeeSkill[]
  certificates       EmployeeCertificate[]
  trainings          TrainingParticipation[]
  leaveRequests      LeaveRequest[]
  leaveBalances      LeaveBalance[]
  businessTrips      BusinessTrip[]
  performanceReviews PerformanceReview[] @relation("ReviewedEmployee")
  givenReviews       PerformanceReview[] @relation("Reviewer")
