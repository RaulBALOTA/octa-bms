// =====================================================================
// OCTA Business Management System — Database Schema
// PostgreSQL 16 · Prisma ORM
//
// Conventions
//  - Every business entity carries: createdAt/updatedAt, createdById/
//    updatedById (audit), deletedAt (soft delete), companyId (multi-company)
//  - History is captured in AuditLog (field-level change tracking) plus
//    explicit version tables where legal traceability is required
//    (ContractVersion, DocumentVersion, ArticleVersion, ProposalVersion)
//  - Cross-cutting features (tags, comments, attachments, custom fields,
//    favorites, saved views, activity timeline) use polymorphic
//    entityType/entityId references
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

enum CalendarDomain {
  CORPORATE
  FINANCE
  SALES
  HR
  OPERATIONS
  MEETING
  COMMITMENT
}

enum CalendarKind {
  APPOINTMENT
  DEADLINE
  OBLIGATION
  MILESTONE
  DECISION
  FORECAST
  FOLLOW_UP
}

enum CalendarStatus {
  DRAFT
  OPEN
  IN_PROGRESS
  AWAITING
  AT_RISK
  COMPLETED
  CANCELED
}

enum CalendarSensitivity {
  PUBLIC_INTERNAL
  TEAM
  RESTRICTED
  PRIVATE
}

model BusinessCalendarItem {
  id String @id @default(cuid())
  companyId String
  title String
  description String?
  domain CalendarDomain
  kind CalendarKind
  status CalendarStatus @default(OPEN)
  sensitivity CalendarSensitivity @default(PUBLIC_INTERNAL)
  priority Int @default(1)
  ownerUserId String?
  createdById String
  timezoneIana String @default("Europe/Berlin")
  allDay Boolean @default(false)
  dateOnly String?
  endDateOnly String?
  startsAt DateTime?
  endsAt DateTime?
  hardDueDate String?
  internalTargetDate String?
  forecastDate String?
  hardDueAt DateTime?
  completionEvidenceRequired Boolean @default(false)
  completedAt DateTime?
  completedById String?
  sourceKind String @default("MANUAL")
  sourceUrl String?
  businessEntityType String?
  businessEntityId String?
  recurrenceFrequency String?
  recurrenceInterval Int @default(1)
  recurrenceUntil String?
  recurrenceAnchor String?
  recurrenceSeriesId String?
  originalOccurrenceKey String?
  occurrenceNumber Int @default(0)
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  company Company @relation(fields: [companyId], references: [id])
  owner User? @relation("CalendarOwner", fields: [ownerUserId], references: [id])
  checklist BusinessCalendarChecklistItem[]
  evidence BusinessCalendarEvidence[]
  grants BusinessCalendarAccessGrant[]
  history BusinessCalendarHistory[]
  @@unique([companyId, recurrenceSeriesId, originalOccurrenceKey])
  @@index([companyId, domain, status])
  @@index([companyId, ownerUserId])
  @@index([companyId, dateOnly])
  @@index([companyId, hardDueDate])
  @@index([companyId, startsAt])
  @@index([companyId, hardDueAt])
  @@map("business_calendar_items")
}

model BusinessCalendarChecklistItem {
  id String @id @default(cuid())
  itemId String
  title String
  done Boolean @default(false)
  item BusinessCalendarItem @relation(fields: [itemId], references: [id])
  @@index([itemId])
  @@map("business_calendar_checklist_items")
}

model BusinessCalendarEvidence {
  id String @id @default(cuid())
  itemId String
  title String
  url String
  createdById String
  createdAt DateTime @default(now())
  item BusinessCalendarItem @relation(fields: [itemId], references: [id])
  @@index([itemId])
  @@map("business_calendar_evidence")
}

model BusinessCalendarAccessGrant {
  id String @id @default(cuid())
  itemId String
  userId String
  canEdit Boolean @default(false)
  item BusinessCalendarItem @relation(fields: [itemId], references: [id])
  @@unique([itemId, userId])
  @@map("business_calendar_access_grants")
}

model BusinessCalendarHistory {
  id String @id @default(cuid())
  itemId String
  actorId String
  action String
  version Int
  changes Json
  createdAt DateTime @default(now())
  item BusinessCalendarItem @relation(fields: [itemId], references: [id])
  @@index([itemId, createdAt])
  @@map("business_calendar_history")
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================================
// 1. IDENTITY & ACCESS MANAGEMENT
// =====================================================================

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String?   // null when SSO-only
  entraObjectId     String?   @unique // Azure Entra ID SSO
  firstName         String
  lastName          String
  displayName       String?
  avatarUrl         String?
  locale            String    @default("de") // de | en
  timeZone          String    @default("Europe/Berlin")
  theme             String    @default("system") // light | dark | system
  isActive          Boolean   @default(true)
  isSystemAdmin     Boolean   @default(false)
  mfaEnabled        Boolean   @default(false)
  mfaSecret         String?
  lastLoginAt       DateTime?
  passwordChangedAt DateTime?
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberships     CompanyMembership[]
  userRoles       UserRole[]
  userGroups      UserGroup[]
  apiKeys         ApiKey[]
  refreshTokens   RefreshToken[]
  notifications   Notification[]
  favorites       Favorite[]
  savedViews      SavedView[]
  auditLogs       AuditLog[]
  activities      ActivityLog[]
  comments        Comment[]
  employee        Employee?
  assignedTasks   Task[]              @relation("TaskAssignee")
  createdTasks    Task[]              @relation("TaskCreator")
  approvalActions ApprovalAction[]
  sentMessages     DirectMessage[]    @relation("SentMessages")
  receivedMessages DirectMessage[]    @relation("ReceivedMessages")
  ownedCalendarItems BusinessCalendarItem[] @relation("CalendarOwner")
  createdOrgChartVersions OrgChartVersion[]
  staffingBudgetScenarios StaffingBudgetScenario[]
  staffingBudgetRevisions StaffingBudgetRevision[]

  @@index([email])
  @@index([isActive])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Role {
  id          String  @id @default(cuid())
  code        String  @unique // e.g. "FINANCE_MANAGER"
  name        String
  nameDe      String?
  description String?
  isSystem    Boolean @default(false) // built-in, non-deletable

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  permissions RolePermission[]
  userRoles   UserRole[]

  @@map("roles")
}

model Permission {
  id       String @id @default(cuid())
  code     String @unique // "crm.clients.read" | "finance.invoices.approve"
  module   String // "crm", "finance", ...
  resource String // "clients", "invoices", ...
  action   String // "read" | "create" | "update" | "delete" | "approve" | "export"
  name     String

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// Role assignment scoped to a company (and optionally office/department)
model UserRole {
  id           String  @id @default(cuid())
  userId       String
  roleId       String
  companyId    String?
  officeId     String?
  departmentId String?

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  company    Company?    @relation(fields: [companyId], references: [id])
  office     Office?     @relation(fields: [officeId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])

  @@unique([userId, roleId, companyId, officeId, departmentId])
  @@index([userId])
  @@map("user_roles")
}

model Group {
  id          String  @id @default(cuid())
  name        String
  description String?
  companyId   String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company Company?    @relation(fields: [companyId], references: [id])
  members UserGroup[]

  @@map("groups")
}

model UserGroup {
  userId  String
  groupId String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
  @@map("user_groups")
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  keyHash    String    @unique
  prefix     String // first 8 chars, shown in UI
  scopes     String[] // permission codes
  expiresAt  DateTime?
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

model CompanyMembership {
  id        String  @id @default(cuid())
  userId    String
  companyId String
  isDefault Boolean @default(false)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@map("company_memberships")
}

// =====================================================================
// 2. MASTER DATA — ORGANIZATION
// =====================================================================

model Company {
  id                 String  @id @default(cuid())
  code               String  @unique // "OCTA-DE"
  parentCompanyId    String? // group structure: subsidiary → holding
  name               String
  legalName          String?
  legalForm          String? // GmbH, AG, GmbH & Co. KG
  vatId              String? // USt-IdNr.
  taxNumber          String? // Steuernummer
  commercialRegister String? // HRB 12345, Amtsgericht München
  street             String?
  postalCode         String?
  city               String?
  countryCode        String?
  phone              String?
  email              String?
  website            String?
  logoUrl            String?
  defaultCurrency    String  @default("EUR")
  defaultLocale      String  @default("de")
  fiscalYearStart    Int     @default(1) // month
  isActive           Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  country          Country?            @relation(fields: [countryCode], references: [code])
  parentCompany    Company?            @relation("CompanyGroup", fields: [parentCompanyId], references: [id])
  subsidiaries     Company[]           @relation("CompanyGroup")
  offices          Office[]
  departments      Department[]
  businessUnits    BusinessUnit[]
  costCenters      CostCenter[]
  profitCenters    ProfitCenter[]
  memberships      CompanyMembership[]
  userRoles        UserRole[]
  groups           Group[]
  employees        Employee[]
  businessPartners BusinessPartner[]
  bankAccounts     BankAccount[]
  contracts        Contract[]
  invoices         Invoice[]
  budgets          Budget[]
  assets           Asset[]
  opportunities    Opportunity[]
  proposals        Proposal[]
  purchaseRequests PurchaseRequest[]
  purchaseOrders   PurchaseOrder[]
  announcements    Announcement[]
  companyGoals     CompanyGoal[]
  calendarItems    BusinessCalendarItem[]
  positionPlans    PositionPlan[]
  orgChartVersions OrgChartVersion[]
  staffingBudgets  StaffingBudgetScenario[]
  engineSettings        EngineSettings?
  engineServices        EngineService[]
  enginePackages        EnginePackage[]
  engineResources       EngineResource[]
  engineAssignments     EngineAssignment[]
  engineScenarios       EngineScenario[]
  engineOptimizations   EngineOptimizationRun[]
  engineAlerts          EngineAlert[]
  engineActions         EngineAction[]
  engineRecommendations EngineRecommendation[]
  engineDecisions       EngineDecision[]
  engineRecalibrations  EngineRecalibration[]

  @@map("companies")
}

model Office {
  id          String  @id @default(cuid())
  companyId   String
  code        String
  name        String
  street      String?
  postalCode  String?
  city        String?
  countryCode String?
  phone       String?
  email       String?
  latitude    Float?
  longitude   Float?
  isHQ        Boolean @default(false)
  isActive    Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company   Company    @relation(fields: [companyId], references: [id])
  country   Country?   @relation(fields: [countryCode], references: [code])
  employees Employee[]
  userRoles UserRole[]

  jobOpenings JobOpening[]

  @@unique([companyId, code])
  @@map("offices")
}

model Department {
  id             String  @id @default(cuid())
  companyId      String
  businessUnitId String?
  parentId       String?
  code           String
  name           String
  nameDe         String?
  managerId      String? // Employee
  costCenterId   String?
  isActive       Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company      Company       @relation(fields: [companyId], references: [id])
  businessUnit BusinessUnit? @relation(fields: [businessUnitId], references: [id])
  parent       Department?   @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children     Department[]  @relation("DepartmentHierarchy")
  manager      Employee?     @relation("DepartmentManager", fields: [managerId], references: [id])
  costCenter   CostCenter?   @relation(fields: [costCenterId], references: [id])
  employees    Employee[]
  positions    Position[]
  userRoles    UserRole[]
  jobOpenings  JobOpening[]

  @@unique([companyId, code])
  @@map("departments")
}

model BusinessUnit {
  id        String  @id @default(cuid())
  companyId String
  code      String
  name      String
  leadId    String? // Employee
  isActive  Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company     Company      @relation(fields: [companyId], references: [id])
  lead        Employee?    @relation(fields: [leadId], references: [id])
  departments Department[]

  @@unique([companyId, code])
  @@map("business_units")
}

model CostCenter {
  id          String  @id @default(cuid())
  companyId   String
  code        String
  name        String
  description String?
  isActive    Boolean @default(true)
  parentId    String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company     Company      @relation(fields: [companyId], references: [id])
  parent      CostCenter?  @relation("CostCenterHierarchy", fields: [parentId], references: [id])
  children    CostCenter[] @relation("CostCenterHierarchy")
  departments Department[]
  budgetLines BudgetLine[]
  invoiceLines InvoiceLine[]

  @@unique([companyId, code])
  @@index([parentId])
  @@map("cost_centers")
}

model ProfitCenter {
  id        String  @id @default(cuid())
  companyId String
  code      String
  name      String
  isActive  Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, code])
  @@map("profit_centers")
}

// =====================================================================
// 3. MASTER DATA — REFERENCE
// =====================================================================

model Country {
  code     String @id // ISO 3166-1 alpha-2
  name     String
  nameDe   String
  isEU     Boolean @default(false)
  phoneCode String?

  companies        Company[]
  offices          Office[]
  businessPartners BusinessPartner[]

  @@map("countries")
}

model Currency {
  code           String @id // ISO 4217
  name           String
  symbol         String
  decimalPlaces  Int    @default(2)
  isActive       Boolean @default(true)

  exchangeRates ExchangeRate[]

  @@map("currencies")
}

model ExchangeRate {
  id           String   @id @default(cuid())
  currencyCode String
  rateToEUR    Decimal  @db.Decimal(18, 8)
  validFrom    DateTime

  currency Currency @relation(fields: [currencyCode], references: [code])

  @@unique([currencyCode, validFrom])
  @@map("exchange_rates")
}

model LanguageRef {
  code   String @id // ISO 639-1
  name   String
  nameDe String

  @@map("languages")
}

model TaxCode {
  id          String  @id @default(cuid())
  code        String  @unique // "DE-19", "DE-7", "DE-0-13B"
  name        String
  ratePercent Decimal @db.Decimal(5, 2)
  countryCode String  @default("DE")
  type        String  @default("VAT") // VAT | REVERSE_CHARGE | EXEMPT | INTRA_EU
  datevCode   String? // DATEV BU-Schlüssel
  isActive    Boolean @default(true)

  invoiceLines InvoiceLine[]

  @@map("tax_codes")
}

model ContractTypeRef {
  id       String  @id @default(cuid())
  code     String  @unique
  name     String
  nameDe   String?
  category String // CLIENT | SUPPLIER | FRAMEWORK | NDA | EMPLOYMENT | INSURANCE
  isActive Boolean @default(true)

  contracts Contract[]

  @@map("contract_types")
}

model DocumentTypeRef {
  id              String  @id @default(cuid())
  code            String  @unique
  name            String
  nameDe          String?
  retentionYears  Int? // German GoBD: 6 or 10 years
  requiresApproval Boolean @default(false)
  isActive        Boolean @default(true)

  documents Document[]

  @@map("document_types")
}

model AssetCategory {
  id                String  @id @default(cuid())
  code              String  @unique
  name              String
  nameDe            String?
  depreciationYears Int?
  requiresCalibration Boolean @default(false)
  isActive          Boolean @default(true)

  assets Asset[]

  @@map("asset_categories")
}

model VehicleType {
  id       String  @id @default(cuid())
  code     String  @unique
  name     String
  isActive Boolean @default(true)

  @@map("vehicle_types")
}

model Bank {
  id       String  @id @default(cuid())
  bic      String  @unique
  name     String
  city     String?
  countryCode String?

  bankAccounts BankAccount[]

  @@map("banks")
}

model BankAccount {
  id            String  @id @default(cuid())
  companyId     String
  bankId        String?
  name          String
  iban          String  @unique
  bic           String?
  currencyCode  String  @default("EUR")
  openingBalance Decimal @default(0) @db.Decimal(18, 2)
  isActive      Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company  Company   @relation(fields: [companyId], references: [id])
  bank     Bank?     @relation(fields: [bankId], references: [id])
  payments Payment[]

  @@map("bank_accounts")
}

model ApprovalGroup {
  id        String  @id @default(cuid())
  name      String
  memberIds String[] // User ids
  minApprovals Int  @default(1)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("approval_groups")
}

model EmailTemplate {
  id        String  @id @default(cuid())
  code      String  @unique
  name      String
  subjectDe String
  subjectEn String
  bodyDe    String
  bodyEn    String
  module    String?
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("email_templates")
}

// =====================================================================
// 4. CRM — BUSINESS PARTNERS & ACTIVITIES
// =====================================================================

enum PartnerType {
  CLIENT
  SUPPLIER
  PARTNER
  AUTHORITY
}

enum PartnerStatus {
  LEAD
  PROSPECT
  ACTIVE
  INACTIVE
  BLOCKED
}

model BusinessPartner {
  id             String        @id @default(cuid())
  companyId      String
  partnerNumber  String // auto "C-00001" / "S-00001"
  type           PartnerType
  status         PartnerStatus @default(ACTIVE)
  name           String
  legalName      String?
  legalForm      String?
  vatId          String?
  industryCode   String? // WZ 2008 classification
  segment        String? // A | B | C customer segmentation
  website        String?
  email          String?
  phone          String?
  street         String?
  postalCode     String?
  city           String?
  countryCode    String?
  latitude       Float?
  longitude      Float?
  paymentTermDays Int?
  currencyCode   String        @default("EUR")
  creditLimit    Decimal?      @db.Decimal(18, 2)
  accountManagerId String? // Employee
  rating         Int? // 1-5 supplier evaluation aggregate
  notes          String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  company        Company              @relation(fields: [companyId], references: [id])
  country        Country?             @relation(fields: [countryCode], references: [code])
  accountManager Employee?            @relation(fields: [accountManagerId], references: [id])
  contacts       Contact[]
  crmActivities  CrmActivity[]
  opportunities  Opportunity[]
  contracts      Contract[]
  invoices       Invoice[]
  evaluations    SupplierEvaluation[]
  purchaseOrders PurchaseOrder[]
  legalCases     LegalCase[]
  engineResources   EngineResource[]
  engineAssignments EngineAssignment[]

  @@unique([companyId, partnerNumber])
  @@index([companyId, type])
  @@index([name])
  @@map("business_partners")
}

model Contact {
  id          String  @id @default(cuid())
  partnerId   String
  salutation  String? // Herr | Frau
  title       String? // Dr., Dipl.-Ing.
  firstName   String
  lastName    String
  position    String?
  department  String?
  email       String?
  phone       String?
  mobile      String?
  linkedIn    String?
  isPrimary   Boolean @default(false)
  birthday    DateTime?
  language    String  @default("de")
  gdprConsent Boolean @default(false)
  gdprConsentDate DateTime?
  notes       String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?

  partner       BusinessPartner @relation(fields: [partnerId], references: [id])
  crmActivities CrmActivity[]

  @@index([partnerId])
  @@index([lastName, firstName])
  @@map("contacts")
}

enum CrmActivityType {
  CALL
  EMAIL
  MEETING
  VISIT
  TASK
  NOTE
}

model CrmActivity {
  id            String          @id @default(cuid())
  partnerId     String
  contactId     String?
  opportunityId String?
  type          CrmActivityType
  subject       String
  description   String?
  activityDate  DateTime
  durationMin   Int?
  location      String?
  outcome       String?
  ownerId       String? // Employee; null when logged by a non-employee user
  isCompleted   Boolean         @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?

  partner     BusinessPartner @relation(fields: [partnerId], references: [id])
  contact     Contact?        @relation(fields: [contactId], references: [id])
  opportunity Opportunity?    @relation(fields: [opportunityId], references: [id])
  owner       Employee?       @relation(fields: [ownerId], references: [id])

  @@index([partnerId, activityDate])
  @@map("crm_activities")
}

// =====================================================================
// 5. SALES — OPPORTUNITIES & PROPOSALS
// =====================================================================

enum OpportunityStage {
  LEAD
  QUALIFIED
  GO_NO_GO
  PROPOSAL
  NEGOTIATION
  WON
  LOST
  CANCELLED
}

model Opportunity {
  id               String           @id @default(cuid())
  companyId        String
  partnerId        String
  opportunityNumber String
  title            String
  description      String?
  stage            OpportunityStage @default(LEAD)
  estimatedValue   Decimal?         @db.Decimal(18, 2)
  currencyCode     String           @default("EUR")
  probability      Int              @default(10) // %
  expectedAward    DateTime?
  submissionDeadline DateTime?
  serviceScope     String? // disciplines / services requested
  sector           String? // industry sector
  source           String? // referral, tender platform, existing client
  ownerId          String? // Employee (sales responsible)
  lostReason       String?
  wonDate          DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  company       Company               @relation(fields: [companyId], references: [id])
  partner       BusinessPartner       @relation(fields: [partnerId], references: [id])
  owner         Employee?             @relation(fields: [ownerId], references: [id])
  proposals     Proposal[]
  crmActivities CrmActivity[]
  goNoGo        GoNoGoEvaluation?
  competitors   OpportunityCompetitor[]
  engineAssignments EngineAssignment[]

  @@unique([companyId, opportunityNumber])
  @@index([companyId, stage])
  @@map("opportunities")
}

model GoNoGoEvaluation {
  id             String   @id @default(cuid())
  opportunityId  String   @unique
  decision       String? // GO | NO_GO | CONDITIONAL
  decisionDate   DateTime?
  decisionById   String?
  clientRelation Int? // scoring 1-5
  strategicFit   Int?
  capacity       Int?
  winProbability Int?
  riskLevel      Int?
  totalScore     Int?
  comments       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  opportunity Opportunity @relation(fields: [opportunityId], references: [id])

  @@map("go_no_go_evaluations")
}

model Competitor {
  id       String  @id @default(cuid())
  name     String
  website  String?
  strengths String?
  weaknesses String?

  opportunities OpportunityCompetitor[]

  @@map("competitors")
}

model OpportunityCompetitor {
  opportunityId String
  competitorId  String

  opportunity Opportunity @relation(fields: [opportunityId], references: [id])
  competitor  Competitor  @relation(fields: [competitorId], references: [id])

  @@id([opportunityId, competitorId])
  @@map("opportunity_competitors")
}

enum ProposalStatus {
  DRAFT
  IN_PREPARATION
  IN_REVIEW
  APPROVED
  SUBMITTED
  SHORTLISTED
  WON
  LOST
  WITHDRAWN
}

model Proposal {
  id             String         @id @default(cuid())
  companyId      String
  opportunityId  String
  proposalNumber String
  title          String
  status         ProposalStatus @default(DRAFT)
  submissionDate DateTime?
  validUntil     DateTime?
  totalFee       Decimal?       @db.Decimal(18, 2)
  estimatedCost  Decimal?       @db.Decimal(18, 2)
  estimatedHours Decimal?       @db.Decimal(10, 2)
  marginPercent  Decimal?       @db.Decimal(5, 2)
  currencyCode   String         @default("EUR")
  managerId      String? // Employee — proposal manager

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?

  company     Company           @relation(fields: [companyId], references: [id])
  opportunity Opportunity       @relation(fields: [opportunityId], references: [id])
  manager     Employee?         @relation(fields: [managerId], references: [id])
  versions    ProposalVersion[]
  feeLines    FeeCalculationLine[]

  @@unique([companyId, proposalNumber])
  @@map("proposals")
}

model ProposalVersion {
  id         String   @id @default(cuid())
  proposalId String
  version    Int
  fileId     String? // Document
  note       String?
  createdAt  DateTime @default(now())
  createdById String?

  proposal Proposal @relation(fields: [proposalId], references: [id])

  @@unique([proposalId, version])
  @@map("proposal_versions")
}

model FeeCalculationLine {
  id          String  @id @default(cuid())
  proposalId  String
  discipline  String // e.g. "Structural Engineering"
  role        String // e.g. "Senior Engineer"
  hours       Decimal @db.Decimal(10, 2)
  hourlyRate  Decimal @db.Decimal(10, 2)
  costRate    Decimal? @db.Decimal(10, 2)
  sortOrder   Int     @default(0)

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@map("fee_calculation_lines")
}

model ReferenceProject {
  id           String   @id @default(cuid())
  title        String
  clientName   String
  sector       String?
  country      String?
  servicesProvided String?
  projectValue Decimal? @db.Decimal(18, 2)
  startDate    DateTime?
  endDate      DateTime?
  description  String?
  isPublic     Boolean  @default(false) // usable in proposals

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("reference_projects")
}

// =====================================================================
// 6. CONTRACT MANAGEMENT
// =====================================================================

enum ContractStatus {
  DRAFT
  IN_REVIEW
  IN_APPROVAL
  ACTIVE
  EXPIRED
  TERMINATED
  RENEWED
}

model Contract {
  id             String         @id @default(cuid())
  companyId      String
  partnerId      String?
  contractTypeId String
  contractNumber String
  title          String
  description    String?
  status         ContractStatus @default(DRAFT)
  value          Decimal?       @db.Decimal(18, 2)
  currencyCode   String         @default("EUR")
  startDate      DateTime?
  endDate        DateTime?
  noticePeriodDays Int?
  autoRenewal    Boolean        @default(false)
  renewalMonths  Int?
  signedDate     DateTime?
  riskLevel      String? // LOW | MEDIUM | HIGH
  riskNotes      String?
  ownerId        String? // Employee — contract owner
  parentId       String? // framework agreement parent

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  company      Company            @relation(fields: [companyId], references: [id])
  partner      BusinessPartner?   @relation(fields: [partnerId], references: [id])
  contractType ContractTypeRef    @relation(fields: [contractTypeId], references: [id])
  owner        Employee?          @relation(fields: [ownerId], references: [id])
  parent       Contract?          @relation("FrameworkCalls", fields: [parentId], references: [id])
  callOffs     Contract[]         @relation("FrameworkCalls")
  versions     ContractVersion[]
  obligations  ContractObligation[]
  milestones   PaymentMilestone[]
  variations   VariationOrder[]
  claims       Claim[]
  guarantees   BankGuarantee[]
  engineAssignments EngineAssignment[]

  @@unique([companyId, contractNumber])
  @@index([companyId, status])
  @@index([endDate])
  @@map("contracts")
}

model ContractVersion {
  id          String   @id @default(cuid())
  contractId  String
  version     Int
  fileId      String? // Document
  changeNote  String?
  createdAt   DateTime @default(now())
  createdById String?

  contract Contract @relation(fields: [contractId], references: [id])

  @@unique([contractId, version])
  @@map("contract_versions")
}

model ContractObligation {
  id          String    @id @default(cuid())
  contractId  String
  title       String
  description String?
  dueDate     DateTime?
  recurrence  String? // NONE | MONTHLY | QUARTERLY | YEARLY
  responsibleId String? // Employee
  isFulfilled Boolean   @default(false)
  fulfilledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contract Contract @relation(fields: [contractId], references: [id])

  @@index([dueDate, isFulfilled])
  @@map("contract_obligations")
}

model PaymentMilestone {
  id         String    @id @default(cuid())
  contractId String
  title      String
  amount     Decimal   @db.Decimal(18, 2)
  percentage Decimal?  @db.Decimal(5, 2)
  dueDate    DateTime?
  isInvoiced Boolean   @default(false)
  invoiceId  String?

  contract Contract @relation(fields: [contractId], references: [id])

  @@map("payment_milestones")
}

model VariationOrder {
  id         String   @id @default(cuid())
  contractId String
  voNumber   String
  title      String
  description String?
  amount     Decimal  @db.Decimal(18, 2)
  status     String   @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | REJECTED
  submittedAt DateTime?
  decidedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contract Contract @relation(fields: [contractId], references: [id])

  @@unique([contractId, voNumber])
  @@map("variation_orders")
}

model Claim {
  id          String   @id @default(cuid())
  contractId  String
  claimNumber String
  title       String
  description String?
  direction   String // OUTGOING | INCOMING
  amount      Decimal? @db.Decimal(18, 2)
  status      String   @default("OPEN") // OPEN | NOTIFIED | NEGOTIATION | SETTLED | REJECTED | LITIGATION
  notifiedAt  DateTime?
  settledAt   DateTime?
  settledAmount Decimal? @db.Decimal(18, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contract Contract @relation(fields: [contractId], references: [id])

  @@unique([contractId, claimNumber])
  @@map("claims")
}

model BankGuarantee {
  id          String    @id @default(cuid())
  contractId  String?
  guaranteeNumber String
  type        String // ADVANCE_PAYMENT | PERFORMANCE | WARRANTY | BID_BOND
  issuingBank String
  amount      Decimal   @db.Decimal(18, 2)
  currencyCode String   @default("EUR")
  issuedDate  DateTime?
  expiryDate  DateTime?
  status      String    @default("ACTIVE") // ACTIVE | RETURNED | DRAWN | EXPIRED

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  contract Contract? @relation(fields: [contractId], references: [id])

  @@index([expiryDate])
  @@map("bank_guarantees")
}

model InsurancePolicy {
  id            String    @id @default(cuid())
  policyNumber  String
  type          String // PROFESSIONAL_LIABILITY | PUBLIC_LIABILITY | D_AND_O | CYBER | PROPERTY | VEHICLE
  insurer       String
  coverageAmount Decimal? @db.Decimal(18, 2)
  annualPremium Decimal?  @db.Decimal(18, 2)
  startDate     DateTime?
  endDate       DateTime?
  autoRenewal   Boolean   @default(true)
  notes         String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([endDate])
  @@map("insurance_policies")
}

// =====================================================================
// 7. FINANCE
// =====================================================================

enum InvoiceDirection {
  OUTGOING // AR — Ausgangsrechnung
  INCOMING // AP — Eingangsrechnung
}

enum InvoiceStatus {
  DRAFT
  IN_APPROVAL
  APPROVED
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  DISPUTED
  CANCELLED
}

model Invoice {
  id             String           @id @default(cuid())
  companyId      String
  partnerId      String
  direction      InvoiceDirection
  status         InvoiceStatus    @default(DRAFT)
  invoiceNumber  String // own number (outgoing) or internal register number (incoming)
  externalNumber String? // supplier's invoice number
  invoiceDate    DateTime
  serviceDate    DateTime? // Leistungsdatum (German VAT requirement)
  dueDate        DateTime
  currencyCode   String           @default("EUR")
  netAmount      Decimal          @db.Decimal(18, 2)
  taxAmount      Decimal          @db.Decimal(18, 2)
  grossAmount    Decimal          @db.Decimal(18, 2)
  paidAmount     Decimal          @default(0) @db.Decimal(18, 2)
  reference      String? // client PO / contract reference
  contractId     String?
  notes          String?
  datevExportedAt DateTime?
  xrechnungId    String? // Leitweg-ID for XRechnung e-invoicing
  dunningLevel   Int              @default(0) // 0 = none, 1-3 = Mahnstufe
  lastDunnedAt   DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  company  Company         @relation(fields: [companyId], references: [id])
  partner  BusinessPartner @relation(fields: [partnerId], references: [id])
  lines    InvoiceLine[]
  payments PaymentAllocation[]

  @@unique([companyId, direction, invoiceNumber])
  @@index([companyId, status, dueDate])
  @@map("invoices")
}

model InvoiceLine {
  id           String  @id @default(cuid())
  invoiceId    String
  position     Int
  description  String
  quantity     Decimal @default(1) @db.Decimal(12, 3)
  unit         String  @default("pcs") // h, day, pcs, LS (lump sum)
  unitPrice    Decimal @db.Decimal(18, 4)
  netAmount    Decimal @db.Decimal(18, 2)
  taxCodeId    String
  costCenterId String?
  budgetCategory String? // Kostenart code from the GuV/BWA budget structure (budget-structure.ts)

  invoice    Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  taxCode    TaxCode     @relation(fields: [taxCodeId], references: [id])
  costCenter CostCenter? @relation(fields: [costCenterId], references: [id])

  @@unique([invoiceId, position])
  @@map("invoice_lines")
}

model Payment {
  id            String   @id @default(cuid())
  bankAccountId String
  paymentDate   DateTime
  amount        Decimal  @db.Decimal(18, 2)
  currencyCode  String   @default("EUR")
  direction     String // IN | OUT
  reference     String?
  counterparty  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bankAccount BankAccount         @relation(fields: [bankAccountId], references: [id])
  allocations PaymentAllocation[]

  @@map("payments")
}

model PaymentAllocation {
  id        String  @id @default(cuid())
  paymentId String
  invoiceId String
  amount    Decimal @db.Decimal(18, 2)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@map("payment_allocations")
}

model Budget {
  id        String @id @default(cuid())
  companyId String
  year      Int
  name      String
  status    String @default("DRAFT") // DRAFT | APPROVED | CLOSED

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company Company      @relation(fields: [companyId], references: [id])
  lines   BudgetLine[]

  @@unique([companyId, year, name])
  @@map("budgets")
}

model BudgetLine {
  id           String  @id @default(cuid())
  budgetId     String
  costCenterId String
  category     String // REVENUE | PERSONNEL | RENT | IT | TRAVEL | MARKETING | OTHER
  month        Int // 1-12
  plannedAmount Decimal @db.Decimal(18, 2)
  forecastAmount Decimal? @db.Decimal(18, 2)

  budget     Budget     @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  costCenter CostCenter @relation(fields: [costCenterId], references: [id])

  @@unique([budgetId, costCenterId, category, month])
  @@map("budget_lines")
}

