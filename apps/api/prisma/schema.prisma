  reviewDate   DateTime?
  overallRating Int? // 1-5
  strengths    String?
  improvements String?
  goals        String?
  status       String    @default("PLANNED") // PLANNED | IN_PROGRESS | COMPLETED | ACKNOWLEDGED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation("ReviewedEmployee", fields: [employeeId], references: [id])
  reviewer Employee @relation("Reviewer", fields: [reviewerId], references: [id])

  @@map("performance_reviews")
}

model CvProfile {
  id          String  @id @default(cuid())
  employeeId  String  @unique
  summaryDe   String?
  summaryEn   String?
  keyProjects String? // JSON array of project references
  educationJson String? // JSON
  updatedAt   DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("cv_profiles")
}

// --- Recruitment ---

model JobOpening {
  id           String    @id @default(cuid())
  companyId    String
  departmentId String?
  officeId     String?
  title        String
  departmentName String?
  officeName   String?
  status       String    @default("OPEN") // DRAFT | OPEN | ON_HOLD | FILLED | CANCELLED
  publishedAt  DateTime?
  targetStartDate DateTime?
  description  String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  applicants Applicant[]
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  office     Office? @relation(fields: [officeId], references: [id], onDelete: SetNull)

  @@map("job_openings")
}

model Applicant {
  id           String    @id @default(cuid())
  jobOpeningId String
  firstName    String
  lastName     String
  email        String
  phone        String?
  source       String? // LinkedIn, StepStone, referral
  stage        String    @default("NEW") // NEW | SCREENING | INTERVIEW | OFFER | HIRED | REJECTED | WITHDRAWN
  expectedSalary Decimal? @db.Decimal(18, 2)
  availableFrom DateTime?
  gdprConsentDate DateTime?
  gdprDeleteBy DateTime? // GDPR: delete 6 months after rejection
  notes        String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  jobOpening JobOpening  @relation(fields: [jobOpeningId], references: [id])
  interviews Interview[]

  @@index([gdprDeleteBy])
  @@map("applicants")
}

model Interview {
  id           String    @id @default(cuid())
  applicantId  String
  scheduledAt  DateTime
  type         String // PHONE | VIDEO | ONSITE | TECHNICAL
  interviewerIds String[]
  rating       Int?
  feedback     String?
  result       String? // PROCEED | REJECT | HOLD

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applicant Applicant @relation(fields: [applicantId], references: [id])

  @@map("interviews")
}

