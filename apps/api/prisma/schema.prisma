model EmployeeCertificate {
  id          String    @id @default(cuid())
  employeeId  String
  name        String
  issuer      String?
  issuedDate  DateTime?
  expiryDate  DateTime?
  fileId      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([expiryDate])
  @@map("employee_certificates")
}

model Training {
  id          String    @id @default(cuid())
  title       String
  provider    String?
  category    String? // TECHNICAL | SOFTWARE | SAFETY | LEADERSHIP | LANGUAGE | COMPLIANCE
  startDate   DateTime?
  endDate     DateTime?
  costPerHead Decimal?  @db.Decimal(18, 2)
  maxSeats    Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  participants TrainingParticipation[]

  @@map("trainings")
}

model TrainingParticipation {
  id         String  @id @default(cuid())
  trainingId String
  employeeId String
  status     String  @default("REGISTERED") // REGISTERED | ATTENDED | COMPLETED | CANCELLED
  result     String?

  training Training @relation(fields: [trainingId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([trainingId, employeeId])
  @@map("training_participations")
}

enum LeaveType {
  VACATION
  SICK
  SPECIAL
  UNPAID
  PARENTAL
  OVERTIME_COMPENSATION
  HOME_OFFICE
}

enum LeaveStatus {
  REQUESTED
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
