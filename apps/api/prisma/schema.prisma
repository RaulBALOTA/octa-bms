model Asset {
  id             String      @id @default(cuid())
  companyId      String
  categoryId     String
  assetNumber    String // also encoded in QR code
  name           String
  serialNumber   String?
  manufacturer   String?
  model          String?
  status         AssetStatus @default(IN_STOCK)
  purchaseDate   DateTime?
  purchasePrice  Decimal?    @db.Decimal(18, 2)
  warrantyUntil  DateTime?
  leaseEndDate   DateTime?
  licensePlate   String? // vehicles
  nextServiceDate DateTime? // maintenance / calibration / TÜV
  location       String?
  notes          String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?

  company     Company             @relation(fields: [companyId], references: [id])
  category    AssetCategory       @relation(fields: [categoryId], references: [id])
  assignments AssetAssignment[]
  maintenance MaintenanceRecord[]

  @@unique([companyId, assetNumber])
  @@index([companyId, status])
  @@index([nextServiceDate])
  @@map("assets")
}

model AssetAssignment {
  id         String    @id @default(cuid())
  assetId    String
  employeeId String
  assignedAt DateTime  @default(now())
  returnedAt DateTime?
  note       String?
  handoverSignedAt DateTime?

  asset    Asset    @relation(fields: [assetId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([assetId])
  @@map("asset_assignments")
}

model MaintenanceRecord {
  id          String   @id @default(cuid())
  assetId     String
  type        String // MAINTENANCE | REPAIR | CALIBRATION | INSPECTION | TUV
  performedAt DateTime
  performedBy String?
  cost        Decimal? @db.Decimal(18, 2)
  result      String?
  nextDueDate DateTime?

  asset Asset @relation(fields: [assetId], references: [id])

  @@map("maintenance_records")
}

model SoftwareLicense {
  id          String    @id @default(cuid())
  name        String // "AutoCAD 2026", "MS 365 E3"
  vendor      String?
  licenseType String // PERPETUAL | SUBSCRIPTION | FLOATING | NAMED_USER
  seats       Int       @default(1)
  usedSeats   Int       @default(0)
  costPerYear Decimal?  @db.Decimal(18, 2)
  renewalDate DateTime?
  licenseKey  String?
  assignedUserIds String[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([renewalDate])
  @@map("software_licenses")
}

// =====================================================================
// 12. KNOWLEDGE MANAGEMENT
// =====================================================================

model KnowledgeCategory {
  id       String  @id @default(cuid())
  parentId String?
  name     String
  nameDe   String?
  sortOrder Int    @default(0)

  parent   KnowledgeCategory?  @relation("KnowledgeCategoryTree", fields: [parentId], references: [id])
  children KnowledgeCategory[] @relation("KnowledgeCategoryTree")
  articles KnowledgeArticle[]

  @@map("knowledge_categories")
}

model KnowledgeArticle {
  id         String    @id @default(cuid())
  categoryId String?
  type       String    @default("ARTICLE") // ARTICLE | STANDARD | PROCEDURE | TEMPLATE | LESSON_LEARNED | FAQ
  title      String
  content    String // Markdown
  language   String    @default("de")
  status     String    @default("DRAFT") // DRAFT | IN_REVIEW | PUBLISHED | ARCHIVED
  publishedAt DateTime?
  authorId   String?
  reviewerId String?
  viewCount  Int       @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?

  category KnowledgeCategory? @relation(fields: [categoryId], references: [id])
  versions ArticleVersion[]

  @@index([status])
  @@map("knowledge_articles")
}

model ArticleVersion {
  id        String   @id @default(cuid())
  articleId String
  version   Int
  content   String
  createdAt DateTime @default(now())
  createdById String?

  article KnowledgeArticle @relation(fields: [articleId], references: [id])

  @@unique([articleId, version])
  @@map("article_versions")
}

// =====================================================================
// 13. DOCUMENT MANAGEMENT
// =====================================================================

model Folder {
  id        String  @id @default(cuid())
  parentId  String?
  name      String
  path      String // materialized path "/Contracts/2026"
  companyId String?
  module    String? // owning module, null = general DMS

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  parent    Folder?    @relation("FolderTree", fields: [parentId], references: [id])
  children  Folder[]   @relation("FolderTree")
  documents Document[]

  @@index([path])
  @@map("folders")
}

model Document {
  id             String    @id @default(cuid())
  folderId       String?
  documentTypeId String?
  name           String
  description    String?
  currentVersion Int       @default(1)
  checkedOutById String? // null = not checked out
  checkedOutAt   DateTime?
  retentionUntil DateTime?
  ocrText        String? // extracted full text for search
  entityType     String? // linked business entity ("contract", "invoice", ...)
  entityId       String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?

  folder       Folder?           @relation(fields: [folderId], references: [id])
  documentType DocumentTypeRef?  @relation(fields: [documentTypeId], references: [id])
  versions     DocumentVersion[]

  @@index([entityType, entityId])
  @@index([folderId])
  @@map("documents")
}

model DocumentVersion {
  id         String   @id @default(cuid())
  documentId String
  version    Int
  fileName   String
  mimeType   String
  sizeBytes  Int
  storageKey String // S3/MinIO object key
  checksum   String? // SHA-256
  note       String?
  createdAt  DateTime @default(now())
  createdById String?

  document Document @relation(fields: [documentId], references: [id])

  @@unique([documentId, version])
  @@map("document_versions")
}

// =====================================================================
// 14. WORKFLOW ENGINE
// =====================================================================

model WorkflowDefinition {
  id          String  @id @default(cuid())
  code        String  @unique // "invoice-approval", "leave-approval"
  name        String
  description String?
  module      String
  entityType  String // entity the workflow attaches to
  definition  Json // steps, conditions, escalations (designer output)
  version     Int     @default(1)
  isActive    Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  instances WorkflowInstance[]

  @@map("workflow_definitions")
}

enum WorkflowStatus {
  RUNNING
  COMPLETED
  REJECTED
  CANCELLED
  FAILED
}

model WorkflowInstance {
  id           String         @id @default(cuid())
  definitionId String
  entityType   String
  entityId     String
  status       WorkflowStatus @default(RUNNING)
  currentStep  String?
  context      Json? // runtime variables
  startedById  String?
  startedAt    DateTime       @default(now())
  completedAt  DateTime?

  definition WorkflowDefinition @relation(fields: [definitionId], references: [id])
  tasks      ApprovalTask[]

  @@index([entityType, entityId])
  @@index([status])
  @@map("workflow_instances")
}

enum ApprovalTaskStatus {
  PENDING
  APPROVED
  REJECTED
  DELEGATED
  ESCALATED
  CANCELLED
}

model ApprovalTask {
  id           String             @id @default(cuid())
  instanceId   String
  stepCode     String
  title        String
  assigneeId   String // User
  status       ApprovalTaskStatus @default(PENDING)
  dueAt        DateTime?
  escalateToId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  instance WorkflowInstance @relation(fields: [instanceId], references: [id])
  actions  ApprovalAction[]

  @@index([assigneeId, status])
  @@map("approval_tasks")
}

model ApprovalAction {
  id       String   @id @default(cuid())
  taskId   String
  userId   String
  action   String // APPROVE | REJECT | DELEGATE | COMMENT
  comment  String?
  actedAt  DateTime @default(now())

  task ApprovalTask @relation(fields: [taskId], references: [id])
  user User         @relation(fields: [userId], references: [id])

  @@map("approval_actions")
}

// =====================================================================
// 15. CORPORATE MANAGEMENT
// =====================================================================

model CompanyGoal {
  id        String    @id @default(cuid())
  companyId String
  year      Int
  title     String
  description String?
  category  String? // FINANCIAL | GROWTH | PEOPLE | QUALITY | DIGITALIZATION
  targetValue Decimal? @db.Decimal(18, 2)
  currentValue Decimal? @db.Decimal(18, 2)
  unit      String?
  ownerId   String?
  status    String    @default("ON_TRACK") // ON_TRACK | AT_RISK | OFF_TRACK | ACHIEVED

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company Company @relation(fields: [companyId], references: [id])

  @@map("company_goals")
}

model Announcement {
  id        String    @id @default(cuid())
  companyId String?
  title     String
  content   String
  priority  String    @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  publishAt DateTime  @default(now())
  expiresAt DateTime?
  authorId  String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company Company? @relation(fields: [companyId], references: [id])

  @@map("announcements")
}

model CompanyCalendarEvent {
  id        String   @id @default(cuid())
  companyId String?
  title     String
  type      String // HOLIDAY | COMPANY_EVENT | DEADLINE | TRAINING | OTHER
  startDate DateTime
  endDate   DateTime?
  isAllDay  Boolean  @default(true)
  location  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("company_calendar_events")
}

// =====================================================================
// 16. BUSINESS INTELLIGENCE
// =====================================================================

model Dashboard {
  id        String  @id @default(cuid())
  name      String
  ownerId   String? // null = shared/system dashboard
  module    String?
  layout    Json // widget grid layout
  isDefault Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("dashboards")
}

model ReportDefinition {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  module      String
  query       Json // report builder definition
  outputFormats String[] // PDF | XLSX | CSV

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  schedules ScheduledReport[]

  @@map("report_definitions")
}

model ScheduledReport {
  id         String   @id @default(cuid())
  reportId   String
  cron       String // "0 6 1 * *"
  recipients String[] // emails
  format     String   @default("PDF")
  isActive   Boolean  @default(true)
  lastRunAt  DateTime?

  report ReportDefinition @relation(fields: [reportId], references: [id])

  @@map("scheduled_reports")
}

// =====================================================================
// 17. CROSS-CUTTING — AUDIT, ACTIVITY, NOTIFICATIONS, TAGS, ETC.
// =====================================================================

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  companyId  String?
  entityType String
  entityId   String
  action     String // CREATE | UPDATE | DELETE | RESTORE | LOGIN | EXPORT | APPROVE ...
  changes    Json? // { field: { old, new } }
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// Human-readable timeline entries shown on entity pages & activity feed
model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  entityType String
  entityId   String
  verb       String // "created", "updated status", "commented", "uploaded"
  summary    String
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@map("activity_logs")
}

enum NotificationType {
  APPROVAL_REQUEST
  TASK_ASSIGNED
  CONTRACT_EXPIRING
  INVOICE_DUE
  CERTIFICATE_EXPIRING
  BIRTHDAY
  NEW_EMPLOYEE
  WORKFLOW
  MENTION
  SYSTEM
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  type       NotificationType
  title      String
  body       String?
  entityType String?
  entityId   String?
  link       String?
  isRead     Boolean          @default(false)
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

model Comment {
  id         String    @id @default(cuid())
  entityType String
  entityId   String
  authorId   String
  content    String
  parentId   String?
  mentionIds String[] // mentioned user ids

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  author   User      @relation(fields: [authorId], references: [id])
  parent   Comment?  @relation("CommentThread", fields: [parentId], references: [id])
  replies  Comment[] @relation("CommentThread")

  @@index([entityType, entityId])
  @@map("comments")
}

model Attachment {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  fileName   String
  mimeType   String
  sizeBytes  Int
  storageKey String
  uploadedById String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@map("attachments")
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  color String @default("#6B7280")

  entityTags EntityTag[]

  @@map("tags")
}

model EntityTag {
  tagId      String
  entityType String
  entityId   String

  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([tagId, entityType, entityId])
  @@index([entityType, entityId])
  @@map("entity_tags")
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  entityType  String? // optionally linked to a business entity
  entityId    String?
  assigneeId  String
  creatorId   String
  dueDate     DateTime?
  priority    String    @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  status      String    @default("OPEN") // OPEN | IN_PROGRESS | DONE | CANCELLED
  completedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  assignee User @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creator  User @relation("TaskCreator", fields: [creatorId], references: [id])

  @@index([assigneeId, status])
  @@index([entityType, entityId])
  @@map("tasks")
}

model CustomFieldDefinition {
  id         String  @id @default(cuid())
  entityType String
  key        String
  label      String
  labelDe    String?
  fieldType  String // TEXT | NUMBER | DATE | BOOLEAN | SELECT | MULTI_SELECT | URL
  options    String[] // for SELECT types
  isRequired Boolean @default(false)
  sortOrder  Int     @default(0)

  values CustomFieldValue[]

  @@unique([entityType, key])
  @@map("custom_field_definitions")
}

model CustomFieldValue {
  id           String @id @default(cuid())
  definitionId String
  entityId     String
  value        Json

  definition CustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([definitionId, entityId])
  @@map("custom_field_values")
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  entityType String
  entityId   String
  label      String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId])
  @@map("favorites")
}

model SavedView {
  id         String  @id @default(cuid())
  userId     String
  module     String
  entityType String
  name       String
  viewType   String  @default("LIST") // LIST | KANBAN | CALENDAR | TIMELINE | MAP
  config     Json // filters, sorting, grouping, visible columns
  isShared   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("saved_views")
}

// Sequential number ranges per company & entity ("R-2026-00001")
model NumberSequence {
  id         String @id @default(cuid())
  companyId  String
  entityType String
  prefix     String
  year       Int?
  lastNumber Int    @default(0)
  padding    Int    @default(5)

  @@unique([companyId, entityType, year])
  @@map("number_sequences")
}

// Transactional outbox for reliable event publishing
model OutboxEvent {
  id          String    @id @default(cuid())
  eventType   String // "invoice.approved", "contract.expiring"
  payload     Json
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([publishedAt])
  @@map("outbox_events")
}
