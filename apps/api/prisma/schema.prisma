  crmActivities      CrmActivity[]
  managedPartners    BusinessPartner[]
  ownedOpportunities Opportunity[]
  managedProposals   Proposal[]
  ownedContracts     Contract[]
  cvProfile          CvProfile?

  @@unique([companyId, employeeNumber])
  @@index([companyId, status])
  @@index([lastName, firstName])
  @@map("employees")
}

model Position {
  id           String  @id @default(cuid())
